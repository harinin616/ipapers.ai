# Copy to backend/.env. Placeholders only: never commit real values.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/dlmonitor

# Auth: secret used to sign session tokens (>= 32 random chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_TTL_DAYS=30
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Browser origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Uploads
MAX_UPLOAD_MB=25

# LLM
LLM_API_KEY=CHANGE_ME
LLM_API_URL=https://example.invalid/v1
